{
    "name": "apparelflow-cutting-gate",
    "version": "1.0.0",
    "description": "ApparelFlow ERP - Cutting Operations & Gatekeeper Verification Terminal",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node server/src/index.js",
        "dev:server": "node --watch server/src/index.js",
        "dev:client": "npm --prefix client run dev",
        "build": "npm --prefix client install --include=dev && npm --prefix client run build",
        "test": "vitest run"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
        "cors": "^2.8.6",
        "express": "^4.22.3",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.3.0",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "supertest": "^7.3.1",
        "vitest": "^5.0.3"
    }
}
